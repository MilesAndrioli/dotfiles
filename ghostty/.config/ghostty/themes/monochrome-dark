# Vercel Mono Dark — escala de grises Geist.
# Los colores ANSI se ordenan por brillo según "atención":
# red > yellow > magenta > green > blue > cyan.

background = #0a0a0a
foreground = #ededed
cursor-color = #ededed
cursor-text = #0a0a0a
selection-background = #333333
selection-foreground = #ffffff
split-divider-color = #2e2e2e

palette = 0=#262626
palette = 1=#d7d7d7
palette = 2=#a1a1a1
palette = 3=#c5c5c5
palette = 4=#8f8f8f
palette = 5=#b3b3b3
palette = 6=#7d7d7d
palette = 7=#ededed
palette = 8=#666666
palette = 9=#ffffff
palette = 10=#c9c9c9
palette = 11=#ededed
palette = 12=#b8b8b8
palette = 13=#dadada
palette = 14=#a8a8a8
palette = 15=#ffffff

# Deriva los 256 colores de la paleta base para que también sean grises.
palette-generate = true
