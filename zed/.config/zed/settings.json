{
    // core
    "cli_default_open_behavior": "existing_window",
    "disable_ai": true,

    // extensions
    "auto_install_extensions": {
        "aura-theme": true,
        "catppuccin-blur": true,
        "charmed-icons": true,
        "html": true,
        "astro": true,
        "glsl": true,
    },

    // typography
    "ui_font_size": 15,
    "buffer_line_height": {
        "custom": 2,
    },

    // editor
    "tab_size": 4,
    "soft_wrap": "bounded",
    // "preferred_line_length": 100,
    "show_wrap_guides": false,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "vertical_scroll_margin",
    "show_whitespaces": "none",
    "indent_guides": {
        "enabled": false,
    },
    "seed_search_query_from_cursor": "selection",

    // theme
    "icon_theme": "Soft Charmed Icons",
    "theme": "Catppuccin Mocha (Blur) [Light]",

    "theme_overrides": {
        "Aura Soft Dark": {
            "editor.document_highlight.read_background": "#0000",
            "border": "#41345D",
            "panel.background": "#21202E",
            "title_bar.background": "#21202E",
            "tab_bar.background": "#21202E",
            "tab.inactive_background": "#21202E",
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
            },
        },
        "Catppuccin Mocha (Blur) [Light]": {
            "editor.document_highlight.read_background": "#0000",
            "border": "#FFFFFF33",
            "tab.active_background": "#FFFFFF33",
        },
        "Catppuccin Espresso (Blur) [Light]": {
            "editor.document_highlight.read_background": "#0000",
            "border": "#77777766",
            "tab.active_background": "#77777766",
        },
    },

    // ui clean up
    "gutter": {
        "line_numbers": false,
        "folds": false,
    },
    "scrollbar": {
        "show": "never",
    },
    "title_bar": {
        "show_user_menu": false,
        "show_sign_in": false,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false,
    },
    "tabs": {
        "file_icons": true,
    },
    "status_bar": {
        "experimental.show": false,
    },

    // panels
    "project_panel": {
        "hide_root": true,
        // "auto_fold_dirs": false,
        "indent_guides": {
            "show": "never",
        },
    },
    "git_panel": {
        "dock": "left",
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },

    // approved, needs category

    // experimental
    // "inline_code_actions": false,
    // "show_completion_documentation": false,
    // "hover_popover_enabled": false,
}
