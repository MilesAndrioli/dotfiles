    layout {
        background-color "transparent"
        gaps 12

        preset-column-widths {
            proportion 0.25
            proportion 0.50
            proportion 0.75
        }

        focus-ring {
            off
        }

        border {
            on
            width 1
            active-color "#FFFFFF66"
            inactive-color "#77777766"
        }
    }
