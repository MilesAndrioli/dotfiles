    layout {
        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        gaps 12
        // https://github.com/niri-wm/niri/wiki/Configuration:-Layout#center-focused-column
        // center-focused-column "always"

        preset-column-widths {
            proportion 0.5
            proportion 0.75
            proportion 1.0
        }

        struts {}
    }
